<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(SonicOrcaTargetFramework)</TargetFramework>
    <RootNamespace>SonicOrca.SDL2</RootNamespace>
    <AssemblyName>SonicOrca.SDL2</AssemblyName>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProjectGuid>{1AEDEF69-0893-4DCB-8790-D672A7AE4193}</ProjectGuid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\x86\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(Platform)' != 'Switch'">
    <PackageReference Include="OpenTK" Version="3.3.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' == 'Switch'">
    <Reference Include="OpenTK" HintPath="$(OpenTKSwitchAssembly)" Private="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' != 'Switch'">
    <ProjectReference Include="..\SonicOrca.Common\SonicOrca.Common.csproj" />
    <ProjectReference Include="..\SonicOrca.Resources\SonicOrca.Resources.csproj" />
    <ProjectReference Include="..\SonicOrca\SonicOrca.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' == 'Switch'">
    <Reference Include="SonicOrca.Common" HintPath="..\SonicOrca.Common\bin\Switch\$(Configuration)\SonicOrca.Common.dll" />
    <Reference Include="SonicOrca.Resources" HintPath="..\SonicOrca.Resources\bin\Switch\$(Configuration)\SonicOrca.Resources.dll" />
    <Reference Include="SonicOrca" HintPath="..\SonicOrca\bin\Switch\$(Configuration)\SonicOrca.dll" />
  </ItemGroup>
</Project>
